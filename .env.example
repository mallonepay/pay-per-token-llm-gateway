# ═══════════════════════════════════════════════════════════════════
# x402 LLM Gateway — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The gateway auto-loads .env from the repository root on startup.
# Variables already set in the environment (Docker, Railway, CI, shell)
# always take precedence and are never overridden by .env.
#
# Generate a real JWT_SECRET (REQUIRED):
#   openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────
# 1. Server (Required)
# ──────────────────────────────────────────────

# Node environment: development | production | test
NODE_ENV=development

# Gateway server host and port
HOST=0.0.0.0
PORT=3000

# Public base URL used in payment quotes and instructions.
# Set this to your production gateway URL (e.g. https://x402-gateway.example.com)
# so clients receive usable links even when the server binds 0.0.0.0.
# Falls back to host:port for local dev when left empty.
# PUBLIC_GATEWAY_URL=https://x402-gateway.example.com


# ──────────────────────────────────────────────
# 2. Database & Redis (Required)
# ──────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://x402:x402_dev_password@localhost:5432/x402_gateway

# Redis connection string
REDIS_URL=redis://localhost:6379


# ──────────────────────────────────────────────
# 3. Security (Required)
# ──────────────────────────────────────────────

# JWT secret for dashboard session tokens — MUST be a random 256-bit value.
# The gateway refuses to start when JWT_SECRET is missing or a known placeholder.
# Generate with: openssl rand -base64 32
# ⚠️  Replace the empty value below before starting the gateway.
JWT_SECRET=

# Session duration in seconds (default: 86400 = 24 hours)
# SESSION_DURATION=86400

# CORS origins — comma-separated list of allowed origins.
# Include your dashboard URL(s) and any other trusted frontends.
CORS_ORIGINS=http://localhost:3001

# Express trust proxy setting. Used to resolve the real client IP behind
# Cloudflare/NGINX/Railway for IP-based rate limiting.
# "1" = trust first hop (default), "loopback", or comma-separated proxy IPs.
# TRUST_PROXY=1

# Dev-only auth bypass: when true, accepts "dev-sig-" prefixed signatures
# as any wallet address. NEVER enable this in production.
# AUTH_DEV_MODE=false


# ──────────────────────────────────────────────
# 4. Stellar / Blockchain
# ──────────────────────────────────────────────

# Stellar network: testnet | mainnet | futurenet
STELLAR_NETWORK=testnet

# Horizon API endpoint (defaults shown below per network)
# Testnet:
# HORIZON_URL=https://horizon-testnet.stellar.org
# Mainnet:
# HORIZON_URL=https://horizon.stellar.org
# Futurenet:
# HORIZON_URL=https://horizon-futurenet.stellar.org

# Soroban RPC endpoint (defaults shown below per network)
# Testnet:
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Mainnet:
# SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org
# Futurenet:
# SOROBAN_RPC_URL=https://rpc-futurenet.stellar.org

# USDC token issuer on Stellar
# Testnet:
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet:
# USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN


# ──────────────────────────────────────────────
# 5. Payment & Pricing
# ──────────────────────────────────────────────

# Quote expiry time in seconds (default: 300 = 5 minutes)
# QUOTE_EXPIRY_SECONDS=300

# Minimum payment amount in stroops (smallest unit, 1e-7).
# Default 10000 = 0.001 XLM.
# MIN_PAYMENT_AMOUNT=10000

# Payment verification cache TTL in seconds (default: 3600 = 1 hour)
# PAYMENT_CACHE_TTL=3600


# ──────────────────────────────────────────────
# 6. On-Chain Settlement (Optional)
# ──────────────────────────────────────────────

# Secret key of the contract admin Stellar account.
# Required for on-chain payment recording and escrow settlement.
# Without this, on-chain recording is skipped (Horizon-based verification still works).
# CONTRACT_ADMIN_SECRET=S...

# Opt-in per-token on-chain settlement via the credit-escrow contract.
# After each metered LLM response the gateway charges actual cost from the
# caller's escrow balance and auto-refunds any surplus.
# Requires CONTRACT_ADMIN_SECRET and an escrow contract funded by deposits.
# ESCROW_SETTLEMENT_ENABLED=false


# ──────────────────────────────────────────────
# 7. LLM / Upstream Configuration
# ──────────────────────────────────────────────

# Upstream LLM request timeout in milliseconds (default: 120000 = 2 minutes)
# LLM_REQUEST_TIMEOUT=120000

# Streaming request timeout in milliseconds (default: 600000 = 10 minutes)
# LLM_STREAM_TIMEOUT=600000

# Maximum retries for failed upstream calls (default: 2)
# LLM_MAX_RETRIES=2


# ──────────────────────────────────────────────
# 8. Provider API Keys
# ──────────────────────────────────────────────
#
# For each provider you register, set their upstream API key.
# Replace PROVIDER_ID with the UUID of the provider, uppercased,
# with hyphens replaced by underscores.
#
# Example: if provider ID is "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
#   UPSTREAM_API_KEY_A1B2C3D4_E5F6_7890_ABCD_EF1234567890=sk-your-api-key

# UPSTREAM_API_KEY_YOUR_PROVIDER_ID=sk-your-api-key-here


# ──────────────────────────────────────────────
# 9. Rate Limiting
# ──────────────────────────────────────────────

# Rate limit window in seconds (default: 60)
# RATE_LIMIT_WINDOW=60

# Max unpaid requests per window per IP (default: 10)
# RATE_LIMIT_MAX=10


# ──────────────────────────────────────────────
# 10. Deployed Soroban Contract Addresses
# ──────────────────────────────────────────────
#
# Defaults point to the project's pre-deployed testnet contracts.
# Override if you deployed your own instances.

# PAYMENT_VERIFIER_CONTRACT=CDHGI3A2BXRC5AQDPWEEXUDQMDXTDZYBCLJZWSE5XZKMVEGJ5LLHA4CZ
# CREDIT_ESCROW_CONTRACT=CCE7AWVXPO57W5KDONOPMHDV4S5UBUBMHNJVSAVPL7AZGMD4WQN6WVAP
# MULTISIG_CONTRACT=CDMBVMMNJVAJVAV3T2TAL2TAACGTKYUS45RXNLCYKYUC3VGHBI66NWAA


# ──────────────────────────────────────────────
# 11. Notifications (Optional)
# ──────────────────────────────────────────────

# Webhook notifications (enabled by default)
# WEBHOOK_ENABLED=true
# WEBHOOK_RETRY_COUNT=3
# WEBHOOK_RETRY_DELAY=1000


# ──────────────────────────────────────────────
# 12. Dashboard (Next.js)
# ──────────────────────────────────────────────
#
# These are set in the dashboard's environment (Vercel, Docker, or .env.local).
# They are NOT loaded by the gateway config — only by the Next.js app.

# URL of the gateway API (used by the dashboard to make API calls)
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
