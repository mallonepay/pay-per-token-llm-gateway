# ── Build Stage ──
FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy root workspace files needed for pnpm install
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml nx.json tsconfig.base.json ./

# Copy workspace package.json files for dependency resolution
COPY packages/types/package.json packages/types/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/logger/package.json packages/logger/
COPY packages/validation/package.json packages/validation/
COPY packages/wallet/package.json packages/wallet/
COPY packages/authentication/package.json packages/authentication/
COPY packages/ui/package.json packages/ui/
COPY packages/database/package.json packages/database/
COPY packages/x402-core/package.json packages/x402-core/
COPY packages/analytics/package.json packages/analytics/
COPY packages/notifications/package.json packages/notifications/
COPY apps/dashboard/package.json apps/dashboard/

# Copy full source code
COPY packages/ packages/
COPY apps/dashboard/ apps/dashboard/

# Install dependencies and build
RUN pnpm install --frozen-lockfile
RUN pnpm exec nx build dashboard

# ── Production Stage ──
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production

# Copy standalone server with bundled dependencies
COPY --from=builder /app/dist/apps/dashboard/.next/standalone /app

# Copy static assets (JS bundles, CSS, images)
COPY --from=builder /app/dist/apps/dashboard/.next/static /app/.next/static

# Copy public assets (favicon, logo, etc.)
COPY --from=builder /app/dist/apps/dashboard/public /app/public

# curl for the container HEALTHCHECK (busybox wget in alpine lacks -f exit codes
# on some builds; curl gives a reliable non-zero exit on HTTP >= 400)
RUN apk add --no-cache curl

EXPOSE 3001

# Mirrors the healthcheck in docker-compose(.mainnet).yml so the container is
# self-describing even when run without Compose (docker run / orchestrators).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:3001 || exit 1

CMD ["node", "server.js"]
