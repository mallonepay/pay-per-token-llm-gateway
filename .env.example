# x402 LLM Gateway Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ===========================================
# Database (PostgreSQL via Prisma)
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/x402?schema=public

# ===========================================
# Redis (for caching & rate limiting)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Stellar Network Configuration
# ===========================================
# Network: 'testnet' | 'mainnet'
STELLAR_NETWORK=testnet

# --- Testnet Configuration (default) ---
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_TESTNET_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_TESTNET_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_TESTNET_USDC_ASSET_CODE=USDC

# --- Mainnet Configuration ---
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org
STELLAR_MAINNET_SOROBAN_RPC_URL=https://soroban-rpc.stellar.org
STELLAR_MAINNET_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
STELLAR_MAINNET_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_MAINNET_USDC_ASSET_CODE=USDC

# ===========================================
# Smart Contract Configuration
# ===========================================
# Contract ID for the x402 payment contract (deployed per network)
STELLAR_CONTRACT_ID=

# Contract deployment network (must match STELLAR_NETWORK)
STELLAR_CONTRACT_NETWORK=testnet

# ===========================================
# Gateway Wallet (for receiving payments)
# ===========================================
# Public key of the gateway's Stellar account
STELLAR_GATEWAY_PUBLIC_KEY=
# Secret key (NEVER commit to version control!)
STELLAR_GATEWAY_SECRET_KEY=

# ===========================================
# Upstream LLM Providers
# ===========================================
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Custom providers (JSON array)
# CUSTOM_PROVIDERS=[{"name":"my-llm","baseUrl":"https://api.example.com/v1","apiKey":"sk-"}]

# ===========================================
# Pricing Configuration (USDC per 1K tokens)
# ===========================================
PRICE_PER_1K_INPUT_TOKENS=0.001
PRICE_PER_1K_OUTPUT_TOKENS=0.003
MIN_PAYMENT_AMOUNT=0.001

# ===========================================
# Authentication & Security
# ===========================================
# JWT secret for admin dashboard
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# API key for gateway admin endpoints
ADMIN_API_KEY=

# Webhook secret for payment notifications
WEBHOOK_SECRET=

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Monitoring & Logging
# ===========================================
LOG_LEVEL=info
SENTRY_DSN=

# ===========================================
# Dashboard (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_STELLAR_NETWORK=testnet
