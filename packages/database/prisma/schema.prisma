generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Providers (Merchants) ────────────────────

model Provider {
  id                   String   @id @default(uuid())
  name                 String
  walletAddress        String
  payoutWalletAddress  String?
  webhookUrl           String?
  webhookSecret        String?
  active               Boolean  @default(true)
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  routes               Route[]
  payments             Payment[]
  notifications        Notification[]
  prepaidCredits       PrepaidCredit[]
  underpaymentDebts    UnderpaymentDebt[]

  @@index([walletAddress])
  @@index([active])
}

// ── Protected Routes ─────────────────────────

model Route {
  id             String   @id @default(uuid())
  providerId     String
  path           String
  upstreamUrl    String
  model          String
  pricingModel   String   @default("flat") // "flat" | "per_token"
  flatPrice      String?
  perTokenPrice  String?
  acceptedAssets String[] @default(["USDC"])
  rateLimit      Int      @default(10)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([providerId, path, model])
  @@index([providerId])
  @@index([active])
}

// ── Payments / Transactions ──────────────────

model Payment {
  id            String   @id @default(uuid())
  quoteId       String
  routeId       String
  providerId    String
  txHash        String?
  payerAddress  String?
  amount        BigInt
  asset         String   @default("USDC")
  status        String   @default("pending") // pending | confirmed | failed | refunded | expired
  ledger        Int?
  verifiedAt    DateTime?
  receiptJson   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  route         Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([txHash])
  @@index([txHash])
  @@index([payerAddress])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

// ── Wallets ──────────────────────────────────

model Wallet {
  id          String   @id @default(uuid())
  address     String   @unique
  label       String?
  isProvider  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prepaidCredit PrepaidCredit?

  @@index([address])
}

// ── Underpayment Debts (per-token enforcement) ─
//
// Records the deficit when a per-token request's actual cost (usage tokens ×
// per-token price) exceeds the deposit the payer sent. A payer with open debt
// on a provider must top up (pay deposit + debt in one transaction) before the
// gateway grants further access on that provider.

model UnderpaymentDebt {
  id           String   @id @default(uuid())
  providerId   String
  payerAddress String
  /// Quote whose metered cost exceeded its deposit. Unique — one debt per quote.
  quoteId      String   @unique
  routeId      String
  /// Deficit in stroops (actualCost − deposit), always > 0.
  amount       BigInt
  status       String   @default("open") // open | settled
  createdAt    DateTime @default(now())
  settledAt    DateTime?

  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([payerAddress, providerId, status])
  @@index([providerId, status])
}

// ── Prepaid Credits (v2) ─────────────────────

model PrepaidCredit {
  id             String   @id @default(uuid())
  walletId       String   @unique
  providerId     String
  balance        BigInt    @default(0)
  asset          String   @default("USDC")
  lastDepositTx  String?
  lastDepositAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([providerId])
}

// ── Notifications ────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  providerId String
  event      String
  channel    String   // "email" | "webhook" | "in_app"
  payload    Json
  sent       Boolean  @default(false)
  createdAt  DateTime @default(now())

  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([sent])
  @@index([createdAt])
}

// ── Analytics Events ──────────────────────────

model AnalyticsEvent {
  id            String   @id @default(uuid())
  type          String   // "request:paid" | "request:unpaid" | "payment:verified" | "payment:failed" | "request:forwarded"
  route         String
  providerId    String
  callerAddress String?
  amount        BigInt?
  asset         String?
  responseTime  Int?
  createdAt     DateTime @default(now())

  @@index([providerId])
  @@index([type])
  @@index([createdAt])
  @@index([providerId, type, createdAt])
}

// ── Audit Logs ───────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entityId   String?
  providerId String?
  actor      String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@index([action])
  @@index([entity])
  @@index([actor])
  @@index([createdAt])
}

// ── Payout Proposals (multisig) ───────────────

model PayoutProposal {
  id              String   @id @default(uuid())
  providerId      String
  destination     String
  amount          String
  asset           String   @default("USDC")
  status          String   @default("pending") // pending | approved | executed | rejected
  signerApprovals String[] @default([])
  threshold       Int      @default(1)
  multisigTxHash  String?
  executedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}
