{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm run start:prod",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "variables": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "API_PREFIX": "api/v1",
    "STELLAR_NETWORK": "mainnet",
    "STELLAR_MAINNET_HORIZON_URL": "https://horizon.stellar.org",
    "STELLAR_MAINNET_SOROBAN_RPC_URL": "https://soroban-rpc.stellar.org",
    "STELLAR_MAINNET_NETWORK_PASSPHRASE": "Public Global Stellar Network ; September 2015",
    "STELLAR_MAINNET_USDC_ISSUER": "GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN",
    "STELLAR_MAINNET_USDC_ASSET_CODE": "USDC",
    "STELLAR_CONTRACT_NETWORK": "mainnet",
    "PRICE_PER_1K_INPUT_TOKENS": "0.001",
    "PRICE_PER_1K_OUTPUT_TOKENS": "0.003",
    "MIN_PAYMENT_AMOUNT": "0.001",
    "RATE_LIMIT_WINDOW_MS": "60000",
    "RATE_LIMIT_MAX_REQUESTS": "200",
    "LOG_LEVEL": "info"
  }
}